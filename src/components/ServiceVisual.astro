---
// Code-drawn illustration for each service. Decorative only.
import type { Service } from '../data/services';

interface Props {
	id: Service['id'];
}
const { id } = Astro.props;
const bar = 'h-2 rounded-pill';
---

<div class="pointer-events-none absolute inset-0 flex items-center justify-center p-6 sm:p-10" aria-hidden="true">
	{
		id === 'development' && (
			<div class="relative w-full max-w-md">
				<div class="rounded-md border border-line bg-bg shadow-2xl shadow-black/20 transition-transform duration-700 ease-out-soft group-hover:-translate-y-1.5">
					<div class="flex items-center gap-1.5 border-b border-line px-4 py-3">
						<span class="size-2.5 rounded-full bg-fg/15" />
						<span class="size-2.5 rounded-full bg-fg/15" />
						<span class="size-2.5 rounded-full bg-fg/15" />
						<span class="label ml-3 text-muted">app.ts</span>
					</div>
					<div class="space-y-2.5 p-5 font-mono">
						{[
							[['w-10', 'bg-accent'], ['w-24', 'bg-fg/25']],
							[['w-6', 'bg-fg/15'], ['w-16', 'bg-accent/60'], ['w-20', 'bg-fg/25']],
							[['w-4', 'bg-transparent'], ['w-28', 'bg-fg/25'], ['w-10', 'bg-accent/60']],
							[['w-4', 'bg-transparent'], ['w-14', 'bg-fg/15'], ['w-24', 'bg-fg/25']],
							[['w-8', 'bg-accent'], ['w-12', 'bg-fg/25']],
						].map((row) => (
							<div class="flex gap-2">
								{row.map(([w, c]) => <span class={`${bar} ${w} ${c}`} />)}
							</div>
						))}
					</div>
				</div>
				<div class="absolute -right-3 -bottom-5 flex items-center gap-2 rounded-pill border border-line bg-bg px-4 py-2 shadow-xl shadow-black/20 transition-transform duration-700 ease-out-soft group-hover:-translate-y-1 sm:-right-6">
					<span class="size-2 rounded-full bg-accent" />
					<span class="label text-fg">Deployed</span>
				</div>
			</div>
		)
	}
	{
		id === 'design' && (
			<div class="relative grid w-full max-w-md grid-cols-[1.4fr_1fr] gap-3">
				<div class="relative flex aspect-square items-end overflow-hidden rounded-md border border-line bg-bg p-5 transition-transform duration-700 ease-out-soft group-hover:-rotate-1">
					<div class="absolute inset-0 bg-grid [mask-image:none] opacity-70" />
					<span class="relative text-[clamp(4rem,3rem+4vw,6.5rem)] leading-none font-semibold tracking-[-0.05em]">Aa</span>
					<svg class="absolute top-5 right-5 size-16 text-accent" viewBox="0 0 64 64" fill="none">
						<path d="M8 52C8 28 28 8 56 8" stroke="currentColor" stroke-width="2" />
						<circle cx="8" cy="52" r="4" fill="currentColor" />
						<circle cx="56" cy="8" r="4" fill="currentColor" />
						<path d="M8 52L8 30M56 8L34 8" stroke="currentColor" stroke-width="1" stroke-dasharray="2 3" />
					</svg>
				</div>
				<div class="grid gap-3">
					{['bg-ink', 'bg-paper', 'bg-basil', 'bg-mint'].map((c) => (
						<div class="flex items-center gap-3 rounded-md border border-line bg-bg p-2.5">
							<span class={`size-7 shrink-0 rounded-sm border border-line ${c}`} />
							<span class={`${bar} w-full bg-fg/15`} />
						</div>
					))}
				</div>
			</div>
		)
	}
	{
		id === 'marketing' && (
			<div class="relative w-full max-w-md">
				<div class="rounded-md border border-line bg-bg p-5 shadow-2xl shadow-black/20 transition-transform duration-700 ease-out-soft group-hover:-translate-y-1.5">
					<div class="flex items-center justify-between">
						<span class={`${bar} w-24 bg-fg/25`} />
						<span class="label rounded-pill bg-accent/15 px-2 py-0.5 text-accent">Organic</span>
					</div>
					<svg viewBox="0 0 300 120" class="mt-5 w-full overflow-visible">
						<defs>
							<linearGradient id="mk-area" x1="0" y1="0" x2="0" y2="1">
								<stop offset="0" stop-color="var(--accent)" stop-opacity="0.35" />
								<stop offset="1" stop-color="var(--accent)" stop-opacity="0" />
							</linearGradient>
						</defs>
						<path d="M0 105 C40 100 60 92 90 88 S140 70 170 62 S230 30 300 14 V120 H0Z" fill="url(#mk-area)" />
						<path d="M0 105 C40 100 60 92 90 88 S140 70 170 62 S230 30 300 14" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" />
						<circle cx="300" cy="14" r="5" fill="var(--accent)" />
						{[30, 60, 90].map((y) => <line x1="0" x2="300" y1={y} y2={y} stroke="var(--line)" stroke-dasharray="2 4" />)}
					</svg>
				</div>
				<div class="absolute -bottom-6 -left-3 flex items-center gap-3 rounded-md border border-accent/50 bg-bg px-4 py-3 shadow-xl shadow-black/20 transition-transform duration-700 ease-out-soft group-hover:-translate-y-1 sm:-left-6">
					<svg class="size-5 text-accent" viewBox="0 0 24 24" fill="currentColor">
						<path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z" />
					</svg>
					<div class="space-y-1.5">
						<span class={`${bar} block w-20 bg-fg/30`} />
						<span class={`${bar} block w-14 bg-fg/15`} />
					</div>
				</div>
			</div>
		)
	}
</div>
