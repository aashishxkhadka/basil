---
// Button / link in three variants (spec §5):
//   primary   → filled Basil (Paper on Basil bands), for the main action
//   secondary → outlined, for a second action
//   text      → inline link with arrow, e.g. "See our work"
// Renders <a> when `href` is set, otherwise <button>.
import type { HTMLAttributes } from 'astro/types';
import { withBase } from '../lib/url';

type Variant = 'primary' | 'secondary' | 'text';

type Props = {
	variant?: Variant;
	href?: string;
	type?: 'button' | 'submit' | 'reset';
	/** Show a trailing arrow. On by default for `text`. */
	arrow?: boolean;
	external?: boolean;
	class?: string;
} & Omit<HTMLAttributes<'a'> & HTMLAttributes<'button'>, 'type' | 'class'>;

const {
	variant = 'primary',
	href,
	type = 'button',
	arrow = variant === 'text',
	external = false,
	class: className,
	...rest
} = Astro.props;

const base =
	'group inline-flex items-center justify-center gap-2 font-medium whitespace-nowrap transition duration-200 ease-out-soft';

const variants: Record<Variant, string> = {
	primary:
		'min-h-12 rounded-pill bg-(--btn-bg) px-6 text-[0.9375rem] text-(--btn-fg) hover:-translate-y-px hover:bg-[color-mix(in_oklab,var(--btn-bg)_86%,var(--color-ink))] active:translate-y-0',
	secondary:
		'min-h-12 rounded-pill border border-fg/25 px-6 text-[0.9375rem] text-fg hover:-translate-y-px hover:border-fg active:translate-y-0',
	text: 'min-h-11 text-[0.9375rem] text-fg underline decoration-line underline-offset-[6px] hover:decoration-accent',
};

const Tag = href ? 'a' : 'button';
const linkProps = href
	? { href: withBase(href), ...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {}) }
	: { type };
---

<Tag class:list={[base, variants[variant], className]} {...linkProps} {...rest}>
	<slot />
	{
		arrow && (
			<svg
				class="size-4 shrink-0 transition-transform duration-200 ease-out-soft group-hover:translate-x-0.5"
				viewBox="0 0 16 16"
				fill="none"
				aria-hidden="true"
			>
				<path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
		)
	}
	{external && <span class="sr-only">(opens in a new tab)</span>}
</Tag>
