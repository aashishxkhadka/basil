---
// Case study card: cover, client, headline, services, one-line result.
// Without a cover image it shows a brand pattern instead of a fake screenshot.
import { Image } from 'astro:assets';
import Leaf from './Leaf.astro';
import { withBase } from '../lib/url';
import { serviceLabels, type WorkEntry } from '../lib/work';

interface Props {
	entry: WorkEntry;
	index?: number;
	headingLevel?: 'h2' | 'h3';
}
const { entry, index = 0, headingLevel: H = 'h3' } = Astro.props;
const { data } = entry;
---

<article
	class="card group flex flex-col overflow-hidden"
	data-reveal
	data-services={data.services.join(' ')}
	style={`--reveal-i:${index % 3}`}
>
	<div class="relative aspect-[4/3] overflow-hidden border-b border-line">
		{
			data.cover ? (
				<Image
					src={data.cover}
					alt={data.coverAlt ?? ''}
					widths={[480, 800, 1200]}
					sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
					class="size-full object-cover transition-transform duration-700 ease-out-soft group-hover:scale-[1.03]"
				/>
			) : (
				<div aria-hidden="true" class="absolute inset-0">
					<div class="absolute inset-0 bg-glow" />
					<div class="absolute inset-0 bg-grid [mask-image:none] opacity-60" />
					<div class="absolute inset-0 flex items-center justify-center">
						<span class="absolute size-40 rounded-full border border-line transition-transform duration-700 ease-out-soft group-hover:scale-110" />
						<span class="flex size-20 items-center justify-center rounded-full bg-linear-135 from-(--grad-a) to-(--grad-b) text-bg">
							<Leaf class="size-9" />
						</span>
					</div>
				</div>
			)
		}
		{data.draft && <span class="label absolute top-4 left-4 rounded-pill bg-fg px-2.5 py-1 text-bg">Template · dev only</span>}
	</div>
	<div class="flex flex-1 flex-col p-6 sm:p-7">
		<p class="label text-muted">{data.client} · {data.industry}</p>
		<H class="mt-3 text-h3">
			<a href={withBase(`/work/${entry.id}`)} class="after:absolute after:inset-0 after:rounded-md focus-visible:outline-none">
				{data.title}
			</a>
		</H>
		<p class="mt-2 text-muted">{data.summary}</p>
		<ul class="mt-auto flex flex-wrap gap-2 pt-6">
			{data.services.map((s) => <li class="label rounded-pill border border-line px-2.5 py-1 text-muted">{serviceLabels[s]}</li>)}
		</ul>
	</div>
</article>
