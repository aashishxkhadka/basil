---
// Case study teaser for real work only: client, service, one-line result.
// TODO (step 6): add the cover image via Astro <Image>.
import type { FeaturedWork } from '../data/work';

interface Props {
	work: FeaturedWork;
	index: number;
}
const { work, index } = Astro.props;
---

<article class="card group flex flex-col overflow-hidden" data-reveal style={`--reveal-i:${index}`}>
	<div class="relative aspect-[4/3] overflow-hidden border-b border-line">
		<div class="absolute inset-0 bg-glow"></div>
	</div>
	<div class="flex flex-1 flex-col p-6">
		<p class="label text-muted">{work.service}</p>
		<h3 class="mt-3 text-h3">
			<a href={work.href} class="after:absolute after:inset-0 after:rounded-md">{work.client}</a>
		</h3>
		<p class="mt-2 text-muted">{work.result}</p>
	</div>
</article>
