<style>
	.logo-letters {
		fill: var(--logo-letters);
	}
	.logo-leaf {
		fill: var(--logo-leaf);
	}
	.logo[data-variant='default'] {
		--logo-letters: var(--color-ink);
		--logo-leaf: var(--color-basil);
	}
	.logo[data-variant='reversed'] {
		--logo-letters: var(--color-paper);
		--logo-leaf: var(--color-mint);
	}
