---
// Basilpot wordmark: lowercase "basilpot" with the leaf over the "i".
// Source: brand/logos/svg/basilpot-wordmark(-reversed).svg
// Only the two official colourways are used (never recolour):
//   default  → Ink letters + Basil leaf (on light)
//   reversed → Paper letters + Mint leaf (on dark)
// `auto` follows the surrounding tone (Section `tone`, or dark mode).
interface Props {
	variant?: 'auto' | 'default' | 'reversed';
	class?: string;
	/** Accessible name. Pass an empty string when a parent already labels it. */
	label?: string;
}

const { variant = 'auto', class: className, label = 'Basilpot' } = Astro.props;
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox="0 -869 3792 1019"
	class:list={['logo', className ?? 'h-7', !className?.includes('w-') && 'w-auto']}
	data-variant={variant}
	role={label ? 'img' : undefined}
	aria-label={label || undefined}
	aria-hidden={label ? undefined : 'true'}
	focusable="false"
>
