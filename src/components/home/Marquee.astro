---
// Slow ribbon of capabilities. Decorative restatement of the services list,
// so it is hidden from assistive tech. Pauses on hover; static for reduced motion.
import Leaf from '../Leaf.astro';
import { capabilities } from '../../data/home';
---

<div
	class="marquee overflow-hidden border-y border-line py-7 [mask-image:linear-gradient(to_right,transparent,#000_8%,#000_92%,transparent)]"
	aria-hidden="true"
>
	<div class="marquee-track flex w-max">
		{
			[0, 1].map(() => (
				<ul class="flex shrink-0 items-center">
					{capabilities.map((item) => (
						<li class="flex items-center gap-10 pr-10 text-h3 font-medium whitespace-nowrap">
							{item}
							<Leaf class="size-4 text-accent" />
						</li>
					))}
				</ul>
			))
		}
	</div>
</div>
