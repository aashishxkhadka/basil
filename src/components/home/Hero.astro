---
// Home hero: oversized editorial headline revealed line by line, the leaf
// "seed" graphic, and a bottom bar with subline, CTAs and live Pokhara time.
import Eyebrow from '../Eyebrow.astro';
import Button from '../Button.astro';
import HeroGraphic from '../HeroGraphic.astro';
import { hero } from '../../data/home';
import { primaryCta } from '../../data/site';

const split = (line: string) => {
	const i = line.indexOf(hero.accent);
	return i === -1 ? [line, '', ''] : [line.slice(0, i), hero.accent, line.slice(i + hero.accent.length)];
};
---

<section
	class="relative isolate -mt-16 flex min-h-[100svh] flex-col overflow-hidden pt-16 md:-mt-20 md:pt-20"
	aria-labelledby="hero-title"
>
	<div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
		<div class="absolute inset-0 bg-glow"></div>
		<div class="absolute inset-0 bg-grid"></div>
		<div class="absolute inset-0 bg-grain"></div>
	</div>

	<div class="container-site flex flex-1 flex-col pb-8">
		<!-- Eyebrow + headline move as one block, vertically centred in the hero.
		     Headline is sized from its container, not the viewport, so it always fits:
		     the longest line ("into products.") is 5.83em wide in Geist 600 at this tracking;
		     16cqi uses ~93% of the width, 10.5cqi on desktop leaves room for the graphic.
		     The graphic is centred on the headline and flush with the container's right edge. -->
		<div class="my-auto py-[clamp(2.5rem,1rem+5vw,5rem)]">
			<div class="fade-up" style="--delay:0.05s">
				<Eyebrow>
					{hero.eyebrow}
					<span class="hidden text-muted sm:inline">
						{' · '}<time data-clock-zone="Asia/Kathmandu" class="text-fg tabular-nums">--:--</time> local
					</span>
				</Eyebrow>
			</div>

			<div class="@container relative mt-[clamp(1.25rem,0.75rem+1.6vw,2.5rem)]">
				<h1
					id="hero-title"
					class="relative z-10 -ml-[0.04em] text-[clamp(2.25rem,16cqi,12rem)] leading-[0.86] font-semibold tracking-[-0.055em] whitespace-nowrap lg:text-[clamp(2.25rem,10.5cqi,11rem)]"
				>
					{
						hero.lines.map((line, i) => {
							const [before, accent, after] = split(line);
							return (
								<span class="line-mask" style={`--line-i:${i}`}>
									<span>
										{before}
										{accent && <span class="text-gradient pr-[0.04em]">{accent}</span>}
										{after}
									</span>
								</span>
							);
						})
					}
				</h1>
				<div class="pointer-events-none mx-auto mt-8 w-full max-w-[15rem] sm:mr-0 sm:max-w-[20rem] lg:absolute lg:top-1/2 lg:right-0 lg:mt-0 lg:w-[min(30vw,28rem)] lg:max-w-none lg:-translate-y-1/2">
					<div class="fade-up" style="--delay:0.45s">
						<HeroGraphic />
					</div>
				</div>
			</div>
		</div>

		<!-- Bottom row: subline left, actions right, on the same baseline. -->
		<div class="fade-up grid gap-8 border-t border-line pt-8 md:grid-cols-2 md:items-end" style="--delay:0.6s">
			<p class="max-w-xl text-lead text-muted">{hero.subline}</p>
			<!-- Primary first in DOM/tab order; row-reverse puts it on the right edge from md up. -->
			<div class="flex flex-wrap items-center gap-x-8 gap-y-4 md:flex-row-reverse">
				<Button href={primaryCta.href}>{primaryCta.label}</Button>
				<Button href="/products" variant="text">See what we’ve built</Button>
			</div>
		</div>
	</div>
</section>

<script>
	import '../../scripts/clock';
</script>
