---
// Eyebrow + h2 + optional intro, with an optional action link on the right.
import Eyebrow from './Eyebrow.astro';
import Button from './Button.astro';

interface Props {
	eyebrow: string;
	title: string;
	intro?: string;
	id?: string;
	action?: { label: string; href: string };
}
const { eyebrow, title, intro, id, action } = Astro.props;
---

<div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between" data-reveal>
	<div class="max-w-2xl">
		<Eyebrow>{eyebrow}</Eyebrow>
		<h2 id={id} class="mt-5 text-h2">{title}</h2>
		{intro && <p class="mt-5 text-lead text-muted">{intro}</p>}
	</div>
	{action && <Button href={action.href} variant="text" class="self-start md:self-auto">{action.label}</Button>}
</div>
