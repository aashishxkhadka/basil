# Contact form. Copy to .env and fill in. Both values end up in the public
# page, so only use a public form endpoint/key (never a private API secret).

# Formspree: https://formspree.io/f/yourid
# Web3Forms: https://api.web3forms.com/submit
PUBLIC_FORM_ENDPOINT=

# Web3Forms only: your public access key. Leave empty for Formspree.
PUBLIC_FORM_ACCESS_KEY=
